{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "id": 1,
      "title": "Service Ready",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "lockfree_service_ready", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "title": "Active WebSocket Connections",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "expr": "lockfree_active_websocket_connections", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "title": "Last Snapshot Age (s)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "expr": "time() - lockfree_last_snapshot_timestamp_seconds", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "title": "Configured Tenants",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "expr": "lockfree_tenants", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "title": "HTTP 5xx Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum by (path, status) (rate(lockfree_http_requests_total{status=~\"5..\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Authentication Failures",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "sum by (result) (increase(lockfree_auth_attempts_total{result!=\"success\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Rate Limit Rejections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "sum by (scope) (increase(lockfree_rate_limit_rejections_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Persistence Operations",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "sum by (result) (increase(lockfree_persistence_operations_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "WebSocket Errors",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "sum by (type, operation) (increase(lockfree_websocket_messages_total{result=\"error\"}[5m]))",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "style": "dark",
  "tags": [
    "lockfree",
    "visualizer",
    "observability"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Lock-Free Visualizer Operations",
  "version": 1
}
